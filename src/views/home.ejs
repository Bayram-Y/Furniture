<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/home.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.js"></script>

<body>
  <div class="home-container">
    <header class="bg-primary text-white py-4 mb-4">
      <div class="container text-center">
        <h1 class="display-4">Welcome to My Admin Panel</h1>
        <p class="lead">Manage your application with ease and efficiency</p>
      </div>
    </header>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-lg">
      <div class="container-fluid">
        <a class="navbar-brand fs-3 fw-bold" href="/admin">Admin Panel</a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
          aria-controls="navbarNav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <% if (!member) { %>
            <li class="nav-item">
              <a class="nav-link text-white" href="/admin/signup">Signup</a>
            </li>
            <li class="nav-item">
              <a class="nav-link text-white" href="/admin/login">Login</a>
            </li>
            <% } else { %>
            <li class="nav-item">
              <a class="nav-link text-white" href="/admin/product/all">Menu</a>
            </li>
            <li class="nav-item">
              <a class="nav-link text-white" href="/admin/user/all">Users</a>
            </li>
            <li class="nav-item">
              <a
                class="nav-link text-white"
                href="/admin/logout"
                onclick="return confirm('Do you want to logout?')"
                >Logout</a
              >
            </li>
            <% } %>
          </ul>
        </div>
      </div>
    </nav>

    <section class="container my-5">
      <div class="row">
        <div class="col-md-6 offset-md-3 text-center">
          <h2 class="mb-3">Manage Your Application</h2>
          <p class="text-muted">
            Access various sections using the navigation menu above.
          </p>
        </div>
      </div>
    </section>
    <footer class="container-footer bg-dark text-white py-3 mt-4">
      <div class="footer-text text-center">
        <p class="footer-text mb-0">
          &copy; 2024 My Admin Panel. All Rights Reserved.
        </p>
      </div>
    </footer>
  </div>

  <!-- Include Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
  <script type="text/javascript" src="/js/home.js"></script>
</body>

<%- include('includes/footer') %>
